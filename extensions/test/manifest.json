{
  "manifest_version": 3,
  "name": "Symul Test Alert",
  "version": "1.0.0",
  "description": "Test extension that alerts when a page loads.",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
